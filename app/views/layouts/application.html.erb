<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "UNAM.JURIQUILLA_INB_DIRECTORY" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= javascript_pack_tag 'application', 'data-turbo-track': 'reload', defer: true %>
    <%= stylesheet_link_tag 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css' %>

  </head>
  <body>
    <!-- Navbar -->
 <nav class="navbar">
  <div class="container">
    <a class="navbar-brand" href="#">INB_Directory</a>
    <div class="navbar-menu" id="navbarMenu">
      <ul class="navbar-nav">
        <li><a href="/">Inicio</a></li>
        <li><a href="/about">Acerca de</a></li>
        <li><a href="/contact">Contacto</a></li>
        <li class="language-dropdown">
          🌍 <%= t("navbar.select_language") %>
          <ul class="dropdown-menu">
           <li><%= link_to "🇪🇸 Español", url_for(locale: :es), class: "dropdown-item" %></li>
           <li><%= link_to "🇺🇸 English", url_for(locale: :en), class: "dropdown-item" %></li>
           <li><%= link_to "🇩🇪 Deutsch", url_for(locale: :de), class: "dropdown-item" %></li>
           <li><%= link_to "🇫🇷 Français", url_for(locale: :fr), class: "dropdown-item" %></li>
           <li><%= link_to "🇮🇹 Italiano", url_for(locale: :it), class: "dropdown-item" %></li>
           <li><%= link_to "🇵🇹 Português", url_for(locale: :pt), class: "dropdown-item" %></li>
           <li><%= link_to "🇨🇳 中文", url_for(locale: :zh), class: "dropdown-item" %></li>
           <li><%= link_to "🇯🇵 日本語", url_for(locale: :ja), class: "dropdown-item" %></li>
           <li><%= link_to "🇸🇦 العربية", url_for(locale: :ar), class: "dropdown-item" %></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
 </nav>



    <!-- Contenido principal -->
    <main class="container">
    <div data-controller="prueba">
      Prueba de Stimulus
    </div>
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <p>&copy; <%= Time.now.year %> <%= t('footer.rights') %></p>
    </footer>

    <script>
      function toggleMenu() {
        document.getElementById("navbarMenu").classList.toggle("active");
      }
    </script>
  </body>
</html>



