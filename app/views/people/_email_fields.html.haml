.email-group
  = f.label :email, "Correo Electrónico"
  = f.text_field :email, class: "input-field"
  = f.hidden_field :id

  - if f.object.persisted?
    = f.check_box :_destroy
    = f.label :_destroy, "Eliminar email"

  %button.btn.btn-danger{ type: "button", data: { action: "email#remove" } }
    %i.fa-solid.fa-trash
    Eliminar

