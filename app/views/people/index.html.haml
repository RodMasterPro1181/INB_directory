%h1.title= t('views.people.index.title')

%div.table-wrapper
  %table.people-table
    %thead
      %tr
        %th= Person.human_attribute_name(:name)
        %th= Person.human_attribute_name(:last_name)
        %th= t('views.people.index.actions')
    %tbody
      - @people.each do |person|
        %tr
          %td= person.name
          %td= person.last_name
          %td.actions
            = link_to person_path(person), class: "btn btn-primary" do
              %i.fa-solid.fa-eye
              = t('views.people.index.show')
            = link_to edit_person_path(person), class: "btn btn-warning" do
              %i.fa-solid.fa-pen-to-square
              = t('views.people.index.edit')
            = link_to person_path(person), method: :delete, data: { turbo_confirm: t('views.people.index.confirm_delete') }, class: "btn btn-danger" do
              %i.fa-solid.fa-trash
              = t('views.people.index.destroy')

%div.actions
  = link_to new_person_path, class: "btn btn-success" do
    %i.fa-solid.fa-user-plus
    = t('views.people.index.new')



