%h1.text-center.mb-4= t(action_name == 'new' ? 'views.people.form.title_new' : 'views.people.form.title_edit')

.container
  = form_for @person, html: { class: "needs-validation", novalidate: true } do |f|
    - if @person.errors.any?
      #error_explanation.alert.alert-danger
        %h4= t('views.people.errors.count', count: @person.errors.count)
        %ul
          - @person.errors.full_messages.each do |message|
            %li= message

    .mb-3
      = f.label :name, class: "form-label"
      = f.text_field :name, class: "form-control", required: true

    .mb-3
      = f.label :last_name, class: "form-label"
      = f.text_field :last_name, class: "form-control", required: true

    .actions.mt-3
      = f.submit t('views.people.form.save'), class: "btn btn-primary" do
        %i.fa-solid.fa-floppy-disk.me-1
        = t('views.people.form.save')

  = link_to people_path, class: "btn btn-secondary mt-3" do
    %i.fa-solid.fa-arrow-left.me-1
    = t('views.people.form.back')

