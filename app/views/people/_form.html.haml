= form_for person, html: { novalidate: true, data: { turbo_frame: "person_form" } } do |f|
  - if person.errors.any?
    #error_explanation
      %h4= "Errores encontrados"
      %ul
        - person.errors.full_messages.each do |message|
          %li= message

  .field-group
    = f.label :name
    = f.text_field :name, class: "input-field", required: true, data: { action: "input->emails#autosave" }

  .field-group
    = f.label :last_name
    = f.text_field :last_name, class: "input-field", required: true, data: { action: "input->emails#autosave" }

  %button.btn.btn-success{ type: "submit" }
    %i.fa-solid.fa-floppy-disk
    Guardar
