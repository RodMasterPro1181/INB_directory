%h1.title= t(action_name == 'new' ? 'views.people.form.title_new' : 'views.people.form.title_edit')

%div.form-container
  = form_for @person, html: { novalidate: true, data: { controller: "emails" } } do |f|
    - if @person.errors.any?
      #error_explanation
        %h4= t('views.people.errors.count', count: @person.errors.count)
        %ul
          - @person.errors.full_messages.each do |message|
            %li= message

    .field-group
      = f.label :name
      = f.text_field :name, class: "input-field", required: true

    .field-group
      = f.label :last_name
      = f.text_field :last_name, class: "input-field", required: true

    %h2 Emails
    .emails-container{ data: { emails_target: "emails"} }
      #emails.email-groups
        = f.fields_for :emails do |ff|
          = render 'email_fields', f: ff, new_record: false  # ✅ Renderiza emails existentes

    - new_email_template = capture do
      = f.fields_for :emails, Email.new, child_index: "NEW_RECORD" do |ff|
        = render 'email_fields', f: ff, new_record: true  # ✅ Plantilla para nuevos emails

    %template{ data: { emails_target: "template" } }
      = new_email_template

    %button.btn.btn-primary{ type: "button", data: { action: "emails#add" } }
      %i.fa-solid.fa-plus
      Agregar Email

    .actions
      %button.btn.btn-success{ type: "submit" }
        %i.fa-solid.fa-floppy-disk
        = t('views.people.form.save')

  = link_to people_path, class: "btn btn-secondary" do
    %i.fa-solid.fa-arrow-left
    = t('views.people.form.back')

  