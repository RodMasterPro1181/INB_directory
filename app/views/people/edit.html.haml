%h1.title= t(action_name == 'new' ? 'views.people.form.title_new' : 'views.people.form.title_edit')

%div.form-container
  = form_for @person, html: { novalidate: true } do |f|
    - if @person.errors.any?
      #error_explanation
        %h4= t('views.people.errors.count', count: @person.errors.count)
        %ul
          - @person.errors.full_messages.each do |message|
            %li= message

    .field-group
      = f.label :name
      = f.text_field :name, class: "input-field", required: true

    .field-group
      = f.label :last_name
      = f.text_field :last_name, class: "input-field", required: true

    %h2 Emails
    .emails-container
      = f.fields_for :emails, @person.emails do |email_form|
        .email-group
          = email_form.label :email, "Correo Electrónico"
          = email_form.text_field :email, class: "input-field"
          = email_form.hidden_field :id
          
          - if email_form.object.persisted?
            = email_form.check_box :_destroy
            = email_form.label :_destroy, "Eliminar email"

    %br
    .actions
      %button.btn.btn-success{ type: "submit" }
        %i.fa-solid.fa-floppy-disk
        = t('views.people.form.save')

  = link_to people_path, class: "btn btn-secondary" do
    %i.fa-solid.fa-arrow-left
    = t('views.people.form.back')


